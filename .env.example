# Copy to ".env" — do not commit ".env"
#
# === TMDB (filmler, arama, keşif; ayrı ürün API’si) ===
# Anahtar: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# İsteğe bağlı; boş bırakılırsa https://api.themoviedb.org/3 kullanılır
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
#
# === Moodflix backend (auth / kullanıcı) ===
# Login/register varsayılanı kodda http://localhost:3001; burayı boş bırakırsan o kullanılır.
# Android emülatör: http://10.0.2.2:3001 — fiziksel cihaz: http://BILGISAYAR_LAN_IP:3001
MOODFLIX_API_BASE_URL=http://localhost:3001
# Auth rotaları ön eki (varsayılan /api/auth → POST .../api/auth/register ve .../login)
# MOODFLIX_AUTH_API_PREFIX=/api/auth
# Sağlık kontrolü (tarayıcı): http://localhost:3001/api/auth/health → "ok": true
#
# Profil (JWT: Authorization: Bearer) — varsayılan /api/profile (/profile alias backend’de)
# MOODFLIX_PROFILE_API_PREFIX=/api/profile
